<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boss_invoice_services_view_form" model="ir.ui.view">
        <field name="name">boss.invoice.services.form</field>
        <field name="model">boss.invoice.services</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Choose the services to invoice now; the others stay to invoice. To invoice part of a
                    quantity, change it on the draft invoice. Credit notes are made from the posted invoice.</p>
                <field name="expediente_id" invisible="1"/>
                <field name="allocation_ids">
                    <list>
                        <field name="order_id"/>
                        <field name="product_id"/>
                        <field name="quantity" string="In this file"/>
                        <field name="invoiced_quantity"/>
                        <field name="to_invoice_quantity"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create" type="object" string="Create draft invoice" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
