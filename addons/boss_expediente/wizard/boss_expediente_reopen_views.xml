<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boss_expediente_reopen_view_form" model="ir.ui.view">
        <field name="name">boss.expediente.reopen.form</field>
        <field name="model">boss.expediente.reopen</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">The operations open again and the shipment data can be corrected. The reason is
                    written in the history of the file.</p>
                <group>
                    <field name="expediente_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="e.g. the customer changed the delivery address"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reopen" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
