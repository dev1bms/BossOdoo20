<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Margin by file (roadmap item 7; Cristina CR-O11): forecast and final margin by responsible, salesperson,
         customer, traffic and month. Opened from the menu, which first recomputes the files in progress. -->
    <record id="boss_margin_report_view_pivot" model="ir.ui.view">
        <field name="name">boss.margin.report.pivot</field>
        <field name="model">boss.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Margin by file" sample="1">
                <field name="user_id" type="row"/>
                <field name="traffic_code" type="col"/>
                <field name="amount_sale" type="measure"/>
                <field name="amount_margin_forecast" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="boss_margin_report_view_graph" model="ir.ui.view">
        <field name="name">boss.margin.report.graph</field>
        <field name="model">boss.margin.report</field>
        <field name="arch" type="xml">
            <graph string="Margin by file" type="bar" sample="1">
                <field name="key_date" interval="month"/>
                <field name="amount_margin_forecast" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="boss_margin_report_view_list" model="ir.ui.view">
        <field name="name">boss.margin.report.list</field>
        <field name="model">boss.margin.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="expediente_id"/>
                <field name="key_date"/>
                <field name="partner_id"/>
                <field name="traffic_code"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="salesman_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_sale" sum="Total"/>
                <field name="amount_invoiced" optional="show" sum="Total"/>
                <field name="amount_cost_forecast" sum="Total"/>
                <field name="amount_cost_actual" optional="hide" sum="Total"/>
                <field name="amount_margin_forecast" sum="Total"/>
                <field name="amount_margin_final" optional="show" sum="Total"/>
                <field name="margin_final" optional="hide"/>
                <field name="refreshed_on" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="boss_margin_report_view_search" model="ir.ui.view">
        <field name="name">boss.margin.report.search</field>
        <field name="model">boss.margin.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="expediente_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="salesman_id"/>
                <field name="traffic_code"/>
                <filter name="key_date" string="Important date" date="key_date"/>
                <separator/>
                <filter name="in_progress" string="In progress" domain="[('financial_closed', '=', False)]"/>
                <filter name="closed" string="Financially closed" domain="[('financial_closed', '=', True)]"/>
                <group>
                    <filter name="by_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="by_salesman" string="Salesperson" context="{'group_by': 'salesman_id'}"/>
                    <filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_traffic" string="Traffic" context="{'group_by': 'traffic_code'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'key_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="boss_margin_report_action" model="ir.actions.act_window">
        <field name="name">Margin by file</field>
        <field name="res_model">boss.margin.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No file yet</p>
            <p>Agreed sale, forecast and final margin of every file, by responsible, salesperson, customer, traffic and
                month. The files in progress are recomputed each time the report opens; a file closed financially keeps its
                final figures.</p>
        </field>
    </record>

    <record id="boss_margin_report_open_server_action" model="ir.actions.server">
        <field name="name">Margin by file</field>
        <field name="model_id" ref="model_boss_margin_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_report()</field>
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager'), ref('account.group_account_invoice'), ref('account.group_account_readonly')])]"/>
    </record>
</odoo>
