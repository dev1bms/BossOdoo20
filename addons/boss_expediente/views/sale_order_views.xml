<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.boss.expediente</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="boss_pricing_sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_boss_open_file" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not boss_expediente_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">File</span>
                        <span class="o_stat_value"><field name="boss_expediente_id" readonly="1" options="{'no_open': True}"/></span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='boss_shipment']/group" position="after">
                <group>
                    <group string="Scope">
                        <field name="incoterm" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_origin_place" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_destination_place" readonly="state in ('sale', 'cancel')"/>
                        <label for="boss_scope_pickup" string="BOSS handles"/>
                        <div class="d-flex flex-wrap gap-3">
                            <span><field name="boss_scope_pickup" nolabel="1" readonly="state in ('sale', 'cancel')"/> Pickup</span>
                            <span><field name="boss_scope_origin_customs" nolabel="1" readonly="state in ('sale', 'cancel')"/> Customs origin</span>
                            <span><field name="boss_scope_main" nolabel="1" readonly="state in ('sale', 'cancel')"/> Main carriage</span>
                            <span><field name="boss_scope_destination_customs" nolabel="1" readonly="state in ('sale', 'cancel')"/> Customs destination</span>
                            <span><field name="boss_scope_delivery" nolabel="1" readonly="state in ('sale', 'cancel')"/> Delivery</span>
                        </div>
                    </group>
                    <group string="Parties and goods">
                        <field name="boss_shipper_id" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_consignee_id" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_goods_description" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_packages" readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_requested_service_ids" widget="many2many_tags" options="{'no_create': True}"
                               readonly="state in ('sale', 'cancel')"/>
                        <field name="boss_expediente_id" readonly="state in ('sale', 'cancel')"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
