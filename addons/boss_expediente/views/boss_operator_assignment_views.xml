<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boss_operator_assignment_view_list" model="ir.ui.view">
        <field name="name">boss.operator.assignment.list</field>
        <field name="model">boss.operator.assignment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="traffic_code"/>
                <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                <field name="source" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="boss_operator_assignment_view_search" model="ir.ui.view">
        <field name="name">boss.operator.assignment.search</field>
        <field name="model">boss.operator.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="traffic_code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_user" string="Operator" context="{'group_by': 'user_id'}"/>
                    <filter name="by_traffic" string="Traffic" context="{'group_by': 'traffic_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="boss_operator_assignment_action" model="ir.actions.act_window">
        <field name="name">Operators by customer and traffic</field>
        <field name="res_model">boss.operator.assignment</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No operator assigned yet</p>
            <p>When a file opens, the operator of its customer for its traffic (IMB, IAB, EMB…) becomes its responsible.
                Without one, the responsible is who opened the file. It can always be changed on the file.</p>
        </field>
    </record>
</odoo>
