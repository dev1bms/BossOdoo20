<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate quotation (ADR-010): the customer receives unit rates per container size, per B/L...; the e-mail never
         states an amount (the standard one says «amounting in <total>», a total of alternatives that means nothing). -->
    <data noupdate="1">
        <record id="email_template_rate_quotation" model="mail.template">
            <field name="name">BOSS: Send rate quotation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Rates {{ object.name or 'n/a' }} {{ object.client_order_ref and ('(' + object.client_order_ref + ')') or '' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used for rate quotations (unit rates without quantities): no total in the message</field>
            <field name="email_layout_xmlid">mail.mail_notification_layout_with_responsible_signature</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your rates <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        <t t-if="object.client_order_ref">(<t t-out="object.client_order_ref or ''">CUSTOMER REF</t>)</t>
        are ready for review: each price applies per container of its size and type, per B/L or per the unit shown on
        each line.
        <t t-if="object.validity_date">They are valid until <t t-out="format_date(object.validity_date) or ''">05/05/2026</t>.</t>
        <br/><br/>
        To book, tell us the containers you will ship, or use «Request booking» on the quotation if you are an
        authorised representative.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
