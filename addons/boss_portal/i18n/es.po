#: model_terms:ir.ui.view,arch_db:boss_portal.view_partner_form
msgid "The customer must be this contact's own company: until then the portal shows nothing."
msgstr "El cliente debe ser la propia empresa de este contacto: hasta entonces el portal no muestra nada."

