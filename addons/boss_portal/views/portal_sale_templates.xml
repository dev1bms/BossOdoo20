<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate quotation in the portal (ADR-010): unit rates with their basis, no quantities, no amount per line, no total
         (not even in the page's data attributes); no signature or payment. A shipment quotation keeps the standard page. -->
    <template id="sale_order_portal_template_boss" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[hasclass('o_portal_sale_sidebar')]" position="attributes">
            <attribute name="t-att-data-order-amount-total">0 if sale_order.boss_rate_quotation else sale_order.amount_total</attribute>
        </xpath>
        <xpath expr="//h2[@t-field='sale_order.amount_total']" position="replace">
            <h2 t-if="sale_order.boss_rate_quotation" class="mb-0 text-break">Rates</h2>
            <h2 t-else="" t-field="sale_order.amount_total" class="mb-0 text-break"/>
        </xpath>
        <xpath expr="//span[@t-else=''][@t-field='sale_order.amount_total']" position="replace">
            <t t-else="">
                <span t-if="sale_order.boss_rate_quotation">Rates</span>
                <span t-else="" t-field="sale_order.amount_total"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_quotations_boss" inherit_id="sale.portal_my_quotations">
        <xpath expr="//span[@t-field='quotation.amount_total']" position="replace">
            <span t-if="quotation.boss_rate_quotation" class="text-muted">Rates per unit</span>
            <span t-else="" t-field="quotation.amount_total"/>
        </xpath>
    </template>

    <template id="sale_order_portal_content_rate" name="BOSS rate quotation (portal)">
        <t t-set="viewer" t-value="request.env.user"/>
        <t t-set="can_book" t-value="not sale_order._boss_booking_blockers(viewer)"/>
        <div id="introduction" class="p-3 p-lg-4 bg-100 border rounded-top">
            <small class="text-muted">Rate quotation for <b t-out="sale_order.partner_id.commercial_partner_id.name"/></small>
            <h2 class="mb-0" t-out="sale_order.name"/>
            <div class="d-flex align-items-center gap-1 text-muted small flex-wrap">
                <span t-field="sale_order.date_order" t-options='{"widget": "date"}'/>
                <t t-if="sale_order.validity_date">
                    <span>·</span>
                    <span class="text-warning-emphasis">Valid until <span t-field="sale_order.validity_date" t-options='{"widget": "date"}'/></span>
                </t>
                <span>·</span>
                <span>Currency <t t-out="sale_order.currency_id.name"/></span>
                <t t-if="sale_order.incoterm">
                    <span>·</span>
                    <span t-out="sale_order.incoterm.code"/>
                    <span t-if="sale_order.incoterm_location" t-out="sale_order.incoterm_location"/>
                </t>
                <t t-if="sale_order.boss_origin_port_id or sale_order.boss_destination_port_id">
                    <span>·</span>
                    <span><t t-out="sale_order.boss_origin_port_id.code or '?'"/> → <t t-out="sale_order.boss_destination_port_id.code or '?'"/></span>
                </t>
            </div>
            <p class="mt-2 mb-0 small">Each price applies per unit of its basis (per container of the size and type shown, per B/L...). The total depends on the containers you ship: no total is given here.</p>
        </div>
        <section id="details" class="p-0 p-lg-3 pt-lg-0 border-start border-end border-bottom rounded-bottom">
            <table class="table table-sm mb-0" id="boss_rate_table">
                <thead>
                    <tr>
                        <th class="text-start">Service</th>
                        <th class="text-start">Basis</th>
                        <th class="text-end">Unit price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="sale_order.order_line" t-as="line">
                        <tr t-if="line.display_type == 'line_section'" class="bg-200 fw-bold">
                            <td colspan="3" t-out="line.name"/>
                        </tr>
                        <tr t-elif="line.display_type == 'line_note'" class="fst-italic">
                            <td colspan="3" t-out="line.name"/>
                        </tr>
                        <tr t-elif="not line.display_type">
                            <td t-out="line.name"/>
                            <td class="text-nowrap">
                                <span t-out="line.product_uom_id.name"/>
                                <span t-if="line.boss_container_size"> <t t-out="line.boss_container_size"/>'<t t-if="line.boss_container_type_id"> <t t-out="line.boss_container_type_id.code"/></t></span>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div t-if="not is_html_empty(sale_order.note)" class="p-3 small" t-field="sale_order.note"/>
        </section>

        <section id="boss_booking" class="mt-4 p-3 border rounded">
            <h4>Booking</h4>
            <div t-if="request.params.get('boss_booking') == 'sent'" class="alert alert-success" role="status">
                Your booking request was sent. BOSS reviews it and confirms the shipment with you.
            </div>
            <div t-if="request.params.get('boss_booking_error')" class="alert alert-danger" role="alert"
                 t-out="request.params.get('boss_booking_error')"/>
            <t t-if="sale_order.boss_booking_state == 'requested'">
                <p class="mb-1">Booking request sent on <span t-field="sale_order.boss_booking_requested_on"/>, pending BOSS review:</p>
                <pre class="mb-0" t-out="sale_order.boss_booking_summary"/>
            </t>
            <t t-elif="can_book">
                <form t-attf-action="/my/orders/#{sale_order.id}/boss_booking" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <p>Tell us how many containers you will ship of each rate. BOSS reviews the request; nothing is confirmed, invoiced or charged until BOSS confirms the shipment with you.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Rate</th><th class="text-end" style="width: 9rem;">Containers</th></tr></thead>
                        <tbody>
                            <tr t-foreach="sale_order._boss_booking_lines_available()" t-as="line">
                                <td><t t-out="line.name"/> · <t t-out="line.boss_container_size"/>'<t t-if="line.boss_container_type_id"> <t t-out="line.boss_container_type_id.code"/></t></td>
                                <td class="text-end"><input type="number" min="0" max="99" step="1" class="form-control form-control-sm text-end" t-attf-name="qty_#{line.id}"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <textarea name="note" maxlength="500" rows="2" class="form-control mb-2" placeholder="Note for BOSS (optional)"/>
                    <button type="submit" class="btn btn-primary">Request booking</button>
                </form>
            </t>
            <p t-else="" class="mb-0 text-muted">To book these rates, contact BOSS or an authorised representative of your company.</p>
        </section>
    </template>
</odoo>
