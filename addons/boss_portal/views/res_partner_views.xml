<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.boss.portal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc']" position="after">
                <group string="BOSS customer portal" name="boss_portal" groups="sales_team.group_sale_manager"
                       invisible="is_company">
                    <field name="boss_portal_role"/>
                    <field name="boss_portal_customer_id" options="{'no_create': True}"
                           invisible="not boss_portal_role" required="boss_portal_role"/>
                    <field name="boss_portal_scope_id" invisible="1"/>
                    <div colspan="2" class="text-muted small" invisible="not boss_portal_role or boss_portal_scope_id">
                        The customer must be this contact's own company: until then the portal shows nothing.
                    </div>
                    <div colspan="2" class="text-muted small">
                        The portal account itself is created with the standard «Grant portal access». The role decides what it sees; removing the role or the access stops it at once.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
