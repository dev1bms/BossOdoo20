#. module: boss_pricing_sale
#: model_terms:ir.ui.view,arch_db:boss_pricing_sale.view_order_form
msgid ""
"<span invisible=\"boss_direction != 'import'\">Import: Spain is the destination; the key date is the arrival (ETA) and the delivery address gives the province.</span>\n"
"                        <span invisible=\"boss_direction != 'export'\">Export: Spain is the origin; the key date is the departure (ETD) and the pickup address gives the province.</span>\n"
"                        <span invisible=\"boss_direction != 'cross'\">Cross-trade: neither side is in Spain; the key date is the departure (ETD). Only supplier prices without a Spanish port or country scope apply.</span>\n"
"                        <span invisible=\"boss_direction != 'national'\">National: both sides are in Spain; the key date is the departure (ETD) and the delivery address gives the province.</span>"
msgstr ""
"<span invisible=\"boss_direction != 'import'\">Importación: España es el destino; la fecha clave es la llegada (ETA) y la dirección de entrega da la provincia.</span>\n"
"                        <span invisible=\"boss_direction != 'export'\">Exportación: España es el origen; la fecha clave es la salida (ETD) y la dirección de recogida da la provincia.</span>\n"
"                        <span invisible=\"boss_direction != 'cross'\">Cross-trade: ningún lado está en España; la fecha clave es la salida (ETD). Solo se aplican precios de proveedor sin puerto ni país español.</span>\n"
"                        <span invisible=\"boss_direction != 'national'\">Nacional: los dos lados están en España; la fecha clave es la salida (ETD) y la dirección de entrega da la provincia.</span>"

