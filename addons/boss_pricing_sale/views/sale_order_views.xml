<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.boss.pricing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_boss_add_services" type="object" string="Add services"
                        invisible="state not in ('draft', 'sent')"/>
                <button name="action_boss_update_costs" type="object" string="Update costs"
                        invisible="state not in ('draft', 'sent')"
                        help="Look up supplier prices again (e.g. after a tariff was approved)."/>
                <button name="action_boss_reprice" type="object" string="Re-price"
                        invisible="not boss_pricing_frozen or state != 'sale'" groups="sales_team.group_sale_manager"/>
                <button name="action_boss_add_service" type="object" string="Add a service"
                        invisible="not boss_pricing_frozen or state != 'sale'" groups="sales_team.group_sale_manager"
                        help="Service sold after acceptance: new line with price and reason; accepted lines do not change."/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-warning mb-2" role="alert" invisible="not boss_pricing_alert">
                    <strong>Pricing to complete: </strong><field name="boss_pricing_alert" nolabel="1" class="d-inline"/>
                </div>
                <div class="alert alert-info mb-2" role="status" invisible="not boss_pricing_frozen">
                    Accepted prices are frozen. Changes go through <strong>Re-price</strong>, with a reason.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Ordered by</attribute>
                <attribute name="help">Who orders the shipment and is invoiced: a BOSS client, or an agent (a forwarder abroad) for its own client.</attribute>
            </xpath>
            <xpath expr="//label[@for='commitment_date'][1]" position="attributes">
                <attribute name="string">Final delivery to the client (estimate)</attribute>
            </xpath>
            <xpath expr="//label[@for='commitment_date'][2]" position="attributes">
                <attribute name="string">Final delivery to the client (estimate)</attribute>
            </xpath>
            <!-- The invoice address is the customer's fiscal address and the delivery address lives with the
                 consignee in the Shipment tab (Ángel, 27/10/2026): both standard header fields leave the screen;
                 Odoo keeps filling them (the delivery one follows the Spanish-side address). -->
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- BOSS names only the incoterm; the place is the route (ports, province), not a separate text
                 (Ángel, 28/10/2026). The standard field stays as the anchor of sale_stock and delivery. -->
            <xpath expr="//group[@name='sale_shipping']/field[@name='incoterm_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Shipment" name="boss_shipment">
                    <group>
                        <group string="Case" name="boss_case">
                            <field name="sale_order_template_id" string="Template (case)"
                                   readonly="state in ('sale', 'cancel')" options="{'no_create': True}"
                                   help="The template is the case (air import FOB, sea import FCL...): it fills the direction, mode, load type, incoterm, whose client, what BOSS handles and the services."/>
                            <field name="boss_business" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_direction" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_transport_mode" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_load_type" readonly="state in ('sale', 'cancel')"/>
                            <field name="incoterm" readonly="state in ('sale', 'cancel')" options="{'no_create': True}"/>                            <field name="boss_rate_quotation" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_traffic_code" invisible="not boss_traffic_code"/>
                        </group>
                        <group string="Carrier" name="boss_carrier">
                            <field name="boss_carrier_id" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_haulier_id" invisible="not boss_haulier_id"/>
                            <field name="boss_pricing_frozen" invisible="1"/>
                            <field name="boss_port_kind" invisible="1"/>
                            <field name="boss_port_id" invisible="1"/>
                            <field name="boss_country_id" invisible="1"/>
                            <field name="boss_planned_date" readonly="1" invisible="not boss_planned_date"/>
                        </group>
                    </group>
                    <div class="text-muted small mb-2" invisible="not boss_direction">
                        <span invisible="boss_direction != 'import'">Import: Spain is the destination; the key date is the arrival (ETA) and the delivery address gives the province.</span>
                        <span invisible="boss_direction != 'export'">Export: Spain is the origin; the key date is the departure (ETD) and the pickup address gives the province.</span>
                        <span invisible="boss_direction != 'cross'">Cross-trade: neither side is in Spain; the key date is the departure (ETD). Only supplier prices without a Spanish port or country scope apply.</span>
                        <span invisible="boss_direction != 'national'">National: both sides are in Spain; the key date is the departure (ETD) and the delivery address gives the province.</span>
                    </div>
                    <group>
                        <group string="Origin" name="boss_origin">
                            <field name="boss_shipper_id" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_origin_country_id" readonly="state in ('sale', 'cancel')" options="{'no_create': True}"/>
                            <field name="boss_origin_port_id" readonly="state in ('sale', 'cancel')" options="{'no_create': True}"/>
                            <field name="boss_pickup_address_id" readonly="state in ('sale', 'cancel')"
                                   domain="[('id', 'child_of', boss_shipper_id or partner_id)]"
                                   context="{'default_parent_id': boss_shipper_id or partner_id, 'default_type': 'delivery', 'show_address': 1}"
                                   options="{'always_reload': True}"/>
                            <field name="boss_origin_place" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_inland_state_id" readonly="state in ('sale', 'cancel')" invisible="boss_direction != 'export'"/>
                            <field name="boss_etd" readonly="state in ('sale', 'cancel')"/>
                        </group>
                        <group string="Destination" name="boss_destination">
                            <field name="boss_consignee_id" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_destination_country_id" readonly="state in ('sale', 'cancel')" options="{'no_create': True}"/>
                            <field name="boss_destination_port_id" readonly="state in ('sale', 'cancel')" options="{'no_create': True}"/>
                            <field name="boss_delivery_address_id" readonly="state in ('sale', 'cancel')"
                                   domain="[('id', 'child_of', boss_consignee_id or partner_id)]"
                                   context="{'default_parent_id': boss_consignee_id or partner_id, 'default_type': 'delivery', 'show_address': 1}"
                                   options="{'always_reload': True}"/>
                            <field name="boss_destination_place" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_inland_state_id" readonly="state in ('sale', 'cancel')" invisible="boss_direction == 'export'"/>
                            <field name="boss_eta" readonly="state in ('sale', 'cancel')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cargo" name="boss_cargo">
                            <field name="boss_gross_kg" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_volume_m3" readonly="state in ('sale', 'cancel')" invisible="boss_load_type == 'fcl'"/>
                            <field name="boss_volume_weight_kg" invisible="not boss_transport_mode or boss_load_type == 'fcl'"/>
                            <field name="boss_chargeable_kg" invisible="not boss_transport_mode or boss_load_type == 'fcl'"/>
                            <field name="boss_awb_kg" readonly="state in ('sale', 'cancel')" invisible="boss_transport_mode != 'air'"
                                   placeholder="When the AWB is known"/>
                            <field name="boss_pallets" readonly="state in ('sale', 'cancel')" invisible="boss_load_type == 'fcl'"/>
                            <field name="boss_goods_value" readonly="state in ('sale', 'cancel')"/>
                        </group>
                        <group string="Estimates" name="boss_estimates">
                            <field name="boss_storage_days" readonly="state in ('sale', 'cancel')"/>
                            <field name="boss_duties_amount" readonly="state in ('sale', 'cancel')"/>
                        </group>
                    </group>
                    <separator string="Containers of the shipment (size, type, quantity)" invisible="boss_load_type != 'fcl'"/>
                    <div class="text-muted small mb-1" invisible="boss_load_type != 'fcl' or not boss_rate_quotation">
                        Rate quotation: leave the containers empty while the client has not said how many ship; each per-container service is priced for one container of the size on its line, and the document shows unit rates without a total. Enter the containers before accepting.
                    </div>
                    <field name="boss_container_ids" readonly="state in ('sale', 'cancel')" invisible="boss_load_type != 'fcl'">
                        <list editable="bottom">
                            <field name="size"/>
                            <field name="container_type_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//column[@name='sol_qty']" position="before">
                <field name="boss_pricing_mode" column_invisible="1"/>
                <field name="boss_price_frozen" column_invisible="1"/>
                <field name="boss_quantity_source" column_invisible="1"/>
                <field name="boss_container_size" optional="show" string="Size" readonly="boss_price_frozen" width="50px"
                       invisible="boss_quantity_source not in ('container', 'teu')"/>
                <field name="boss_container_type_id" optional="hide" string="Type" readonly="boss_price_frozen"
                       options="{'no_create': True}" invisible="boss_quantity_source not in ('container', 'teu')"/>
                <field name="boss_execution" optional="show" string="By" readonly="boss_price_frozen" width="80px"
                       invisible="not boss_pricing_mode"/>
                <field name="boss_supplier_id" optional="show" readonly="boss_price_frozen" width="95px"
                       options="{'no_create': True}" invisible="boss_execution == 'boss'"/>
                <field name="boss_cost_method" column_invisible="1"/>
                <field name="boss_days_source" optional="hide" string="Days from" readonly="boss_price_frozen"
                       invisible="boss_cost_method != 'time'"/>
                <field name="boss_days" optional="show" string="Days" readonly="boss_price_frozen" width="55px"
                       invisible="boss_cost_method != 'time'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//column[@name='price_unit']" position="before">
                <field name="boss_cost_status" string="Cost" widget="badge" optional="show" width="85px"
                       decoration-success="boss_cost_status == 'ok'"
                       decoration-warning="boss_cost_status in ('missing_input', 'pending_approval', 'manual', 'not_ready', 'currency', 'on_request')"
                       decoration-danger="boss_cost_status in ('no_tariff', 'conflict')"/>
                <button name="action_boss_pricing_details" type="object" icon="info" title="How the cost is computed" aria-label="How the cost is computed"
                        invisible="not boss_pricing_mode"/>
                <button name="action_boss_add_supplier_price" type="object" icon="add_circle" title="Add supplier price (for this route, with its validity)" aria-label="Add supplier price"
                        invisible="boss_cost_status not in ('no_tariff', 'manual') or boss_execution == 'boss'" groups="boss_pricing.group_tariff_user"/>
                <button name="action_boss_open_tariffs" type="object" icon="check_box" title="Review the supplier price" aria-label="Review the supplier price"
                        invisible="boss_cost_status not in ('pending_approval', 'conflict')"/>
                <button name="action_boss_open_service" type="object" icon="help" title="Open the service" aria-label="Open the service"
                        invisible="boss_cost_status != 'not_ready'"/>
                <field name="boss_manual_cost" string="Manual cost" optional="hide" width="80px"
                       invisible="boss_cost_status not in ('manual', 'not_ready')" readonly="boss_price_frozen"/>
                <field name="boss_manual_cost_note" optional="hide"
                       invisible="boss_cost_status not in ('manual', 'not_ready')" readonly="boss_price_frozen"/>
                <field name="boss_sale_status" string="Sale" widget="badge" optional="show" width="85px"
                       decoration-success="boss_sale_status in ('agreed', 'cost_based', 'manual', 'free')"
                       decoration-danger="boss_sale_status == 'missing'"/>
                <field name="boss_sale_free" optional="hide" readonly="boss_price_frozen"/>
                <field name="boss_cost_is_estimate" optional="hide" string="Estimate"/>
                <field name="boss_cost_kind" optional="hide" widget="badge"
                       decoration-danger="boss_cost_kind == 'unknown'" decoration-warning="boss_cost_kind == 'estimate'"/>
                <field name="boss_unknown_cost_reason" optional="hide" groups="sales_team.group_sale_manager"
                       invisible="boss_cost_kind != 'unknown'" readonly="boss_price_frozen"/>
                <field name="boss_cost_on_request" optional="hide" string="Cost on request" readonly="boss_price_frozen"
                       invisible="boss_execution == 'boss' or not boss_pricing_mode"/>
                <field name="boss_vat_status" string="VAT" widget="badge" optional="hide"
                       decoration-success="boss_vat_status == 'ok'" decoration-danger="boss_vat_status == 'pending'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">is_downpayment or boss_price_frozen</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="string">Selling price (unit)</attribute>
                <attribute name="readonly">qty_invoiced &gt; 0 or boss_price_frozen</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Pricing history" name="boss_pricing_history" invisible="not boss_snapshot_ids">
                    <field name="boss_snapshot_ids">
                        <list>
                            <field name="date"/>
                            <field name="kind"/>
                            <field name="user_id"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- sale_margin adds the unit cost: for BOSS services it comes from the supplier price, never typed. -->
    <record id="sale_margin_sale_order" model="ir.ui.view">
        <field name="name">sale.order.margin.form.boss.pricing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='purchase_price']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="readonly">boss_pricing_mode</attribute>
                <attribute name="string">Buying cost (unit)</attribute>
                <attribute name="width">80px</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='margin_percent']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_view_form_boss_pricing" model="ir.ui.view">
        <field name="name">sale.order.line.form.boss.pricing</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <sheet>
                    <group>
                        <group string="Line">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" string="Charge basis" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="boss_container_size" readonly="1" invisible="not boss_container_size"/>
                            <field name="boss_container_type_id" readonly="1" invisible="not boss_container_type_id"/>
                            <field name="boss_execution" readonly="1"/>
                            <field name="boss_supplier_id" readonly="1" invisible="boss_execution == 'boss'"/>
                            <field name="boss_days_source" readonly="1" invisible="boss_cost_method != 'time'"/>
                            <field name="boss_days" readonly="1" invisible="boss_cost_method != 'time' or boss_days_source == 'shipment'"/>
                            <field name="boss_cost_method" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Result">
                            <field name="boss_cost_status"/>
                            <field name="boss_cost_kind"/>
                            <field name="boss_unknown_cost_reason" invisible="not boss_unknown_cost_reason"/>
                            <field name="boss_cost_amount"/>
                            <field name="boss_cost_currency_id" invisible="1"/>
                            <field name="purchase_price" string="Buying cost per unit (quotation currency)"/>
                            <field name="price_unit" string="Sale price"/>
                            <field name="boss_sale_status" string="Sale price source"/>
                            <field name="margin_percent" widget="percentage" string="Margin (on sale)"/>
                            <field name="boss_markup" widget="percentage"/>
                            <field name="boss_cost_is_estimate"/>
                        </group>
                    </group>
                    <group string="How the cost is computed">
                        <field name="boss_cost_explanation" nolabel="1" colspan="2"/>
                    </group>
                    <group string="How the sale price is set">
                        <field name="pricelist_item_id" readonly="1" invisible="not pricelist_item_id"/>
                        <field name="boss_sale_explanation" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <field name="boss_tariff_line_id" invisible="not boss_tariff_line_id"/>
                        <field name="boss_cost_candidate_ids" widget="many2many_tags" invisible="not boss_cost_candidate_ids"/>
                        <field name="boss_manual_cost_note" invisible="boss_cost_status not in ('manual', 'not_ready')"/>
                    </group>
                    <group string="VAT">
                        <field name="boss_vat_class"/>
                        <field name="boss_vat_status"/>
                        <field name="boss_vat_trace"/>
                        <field name="tax_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
