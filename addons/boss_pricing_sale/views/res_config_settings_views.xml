<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.boss.pricing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="pricelist_configuration" position="after">
                <setting id="boss_fx_policy" string="Supplier cost in another currency"
                         help="What to do when a supplier price is in another currency than the quotation.">
                    <field name="boss_fx_policy"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
