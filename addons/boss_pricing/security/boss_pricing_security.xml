<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_boss_pricing" model="res.groups.privilege">
        <field name="name">BOSS supplier tariffs</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_tariff_user" model="res.groups">
        <field name="name">User: enter tariffs</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_boss_pricing"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Enters supplier tariffs and sends them for approval. Never approves.</field>
    </record>
    <record id="group_tariff_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_boss_pricing"/>
        <field name="implied_ids" eval="[Command.link(ref('group_tariff_user'))]"/>
        <field name="comment">Approves supplier tariffs: only approved prices are used in quotations.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
