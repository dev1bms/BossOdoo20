msgid ""
"The minimum applies to each charged day or period (document: «mínimo … AWB/día», «/expedición/día»), not to the whole stay."
msgstr ""
"El mínimo se aplica a cada día o periodo cobrado (documento: «mínimo … AWB/día», «/expedición/día»), no a toda la estancia."

#. module: boss_pricing
#. odoo-python
#: code:addons/boss_pricing/models/boss_pricing.py:0
msgid "The quantity is outside the brackets of the supplier document."
msgstr "La cantidad está fuera de los tramos del documento del proveedor."

#. module: boss_pricing
#. odoo-python
#: code:addons/boss_pricing/models/boss_pricing.py:0
