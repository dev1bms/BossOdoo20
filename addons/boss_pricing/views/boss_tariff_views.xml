<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boss_tariff_view_form" model="ir.ui.view">
        <field name="name">boss.tariff.form</field>
        <field name="model">boss.tariff</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Send for approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'to_approve'"
                            groups="boss_pricing.group_tariff_approver"
                            confirm="Approved prices are used in quotations and can no longer change. Approve?"/>
                    <button name="action_back_to_draft" type="object" string="Back to draft" invisible="state != 'to_approve'"/>
                    <button name="action_new_version" type="object" string="New version" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Demo" bg_color="text-bg-warning" invisible="not active or not is_demo"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="state != 'draft' or not ws_checklist">
                        <strong>Before sending for approval:</strong>
                        <field name="ws_checklist" class="d-block" style="white-space: pre-line"/>
                    </div>
                    <div class="oe_title mb-1">
                        <h1><field name="name" placeholder="e.g. MSC local charges import 2026"/></h1>
                    </div>
                    <div class="text-muted mb-3" title="Scope of every price of this tariff">
                        <field name="scope_summary" class="d-inline"/>
                    </div>
                    <group>
                        <group string="Supplier and document">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="document" filename="document_name" readonly="state != 'draft'"/>
                            <field name="document_name" invisible="1"/>
                            <field name="document_reference" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Version and validity">
                            <field name="valid_from" readonly="state != 'draft'"/>
                            <field name="valid_to" readonly="state != 'draft'" placeholder="Until a newer version"/>
                            <field name="version"/>
                            <field name="is_demo" readonly="state != 'draft'"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prices" name="prices">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list decoration-danger="ws_is_empty">
                                    <field name="product_id" string="Service" width="300px"/>
                                    <field name="uom_id" string="Charge basis" width="130px"/>
                                    <field name="container_size" string="Size" optional="show"/>
                                    <field name="container_type_ids" widget="many2many_tags" string="Types" optional="show"/>
                                    <field name="price_display"/>
                                    <field name="ws_is_empty" column_invisible="1"/>
                                    <field name="method" optional="hide"/>
                                    <field name="on_request" optional="hide"/>
                                    <field name="free_of_charge" optional="hide"/>
                                    <field name="document_page" string="Page" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Applies to" name="scope">
                            <p class="text-muted">
                                Common to every price of the tariff. Fill a field only when the supplier document limits
                                it: an empty field means the prices apply to any value.
                            </p>
                            <group>
                                <group>
                                    <field name="direction" readonly="state != 'draft'" placeholder="Import and export"/>
                                    <field name="transport_mode" readonly="state != 'draft'" placeholder="Any mode"/>
                                    <field name="load_type" readonly="state != 'draft'" placeholder="Any load"/>
                                    <field name="carrier_id" readonly="state != 'draft'" placeholder="Any carrier"/>
                                </group>
                                <group>
                                    <field name="port_ids" widget="many2many_tags" readonly="state != 'draft'" placeholder="Any port"/>
                                    <field name="country_ids" widget="many2many_tags" readonly="state != 'draft'" placeholder="Any country"/>
                                    <field name="state_ids" widget="many2many_tags" readonly="state != 'draft'" placeholder="Any province"/>
                                    <field name="customer_id" readonly="state != 'draft'" placeholder="Any customer"/>
                                </group>
                            </group>
                            <div class="text-muted small" invisible="not ws_open_scope">
                                Empty, so the prices apply to any: <field name="ws_open_scope" class="d-inline"/>.
                            </div>
                            <group>
                                <field name="scope_confirmed" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Review and approval" name="review">
                            <group>
                                <group>
                                    <field name="state" string="Status" readonly="1"/>
                                    <field name="approved_by_id" invisible="state != 'approved'"/>
                                    <field name="approved_date" invisible="state != 'approved'"/>
                                    <field name="priority"/>
                                </group>
                                <group>
                                    <field name="line_count"/>
                                    <field name="lineage_id" invisible="version == 1"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Whoever enters the prices sends the tariff for approval; an approver checks them against
                                the document and approves. Approved prices never change: a change is a new version.
                            </p>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="boss_tariff_line_view_form" model="ir.ui.view">
        <field name="name">boss.tariff.line.form</field>
        <field name="model">boss.tariff.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <field name="tariff_state" invisible="1"/>
                <widget name="web_ribbon" title="Demo" bg_color="text-bg-warning" invisible="not is_demo"/>
                <div class="alert alert-info mb-2" role="alert" invisible="not id or tariff_state in (False, 'draft')">
                    This price belongs to a tariff sent for approval or approved: it does not change. Open the
                    tariff and create a new version (or set it back to draft) to change it.
                </div>
                <group>
                    <group string="Service and source">
                        <field name="tariff_id" invisible="not context.get('boss_ws')" required="context.get('boss_ws')"
                               domain="[('state', '=', 'draft')]" readonly="id"
                               options="{'no_quick_create': True}"
                               help="Draft tariff of the supplier: document, currency, validity and scope are taken from it."/>
                        <field name="partner_id" invisible="not context.get('boss_ws')"/>
                        <field name="document_reference" invisible="not context.get('boss_ws')"/>
                        <field name="product_id" string="Service" options="{'no_create': True}"
                               help="An existing service of the catalogue. A supplier price never creates a new service."/>
                        <field name="allowed_uom_ids" invisible="1"/>
                        <field name="uom_id"/>
                        <field name="document_page"/>
                    </group>
                    <group string="Applies to">
                        <field name="scope_display" string="Tariff scope" widget="text" invisible="not context.get('boss_ws')"/>
                        <field name="container_size" placeholder="Any size"/>
                        <field name="container_type_ids" widget="many2many_tags" placeholder="Any type"/>
                        <field name="valid_from" invisible="not context.get('boss_ws')"/>
                        <field name="valid_to" invisible="not context.get('boss_ws')" placeholder="Until a newer version"/>
                        <field name="validity_state" widget="badge" invisible="not context.get('boss_ws') or not id"/>
                        <field name="is_demo" invisible="1"/>
                    </group>
                </group>
                <group string="Calculation">
                    <group>
                        <field name="method"/>
                        <field name="basis" invisible="method == 'percent'"/>
                        <field name="volumetric_factor" invisible="basis != 'chargeable_kg' and basis_2 != 'chargeable_kg'"/>
                        <field name="unit_size" invisible="method == 'percent'"/>
                        <field name="round_up" invisible="method == 'percent'"/>
                        <field name="round_undecided" invisible="method != 'time'"/>
                        <label for="unit_price" invisible="method not in ('per_unit', 'max_of_bases')"/>
                        <div class="o_row" invisible="method not in ('per_unit', 'max_of_bases')">
                            <field name="unit_price"/>
                            <field name="ws_price_unit_label" class="text-muted text-nowrap"/>
                        </div>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group invisible="method != 'max_of_bases'" string="Second basis (the larger amount is charged)">
                        <field name="basis_2"/>
                        <field name="b2_unit_size"/>
                        <field name="b2_round_up"/>
                        <label for="unit_price_2"/>
                        <div class="o_row">
                            <field name="unit_price_2"/>
                            <field name="ws_price2_unit_label" class="text-muted text-nowrap"/>
                        </div>
                    </group>
                    <group invisible="method != 'percent'" string="Percentage">
                        <field name="percent_base"/>
                        <label for="rate"/>
                        <div class="o_row">
                            <field name="rate"/>
                            <span class="text-muted">% of the base above</span>
                        </div>
                        <field name="base_product_ids" widget="many2many_tags" invisible="percent_base != 'services'"/>
                    </group>
                </group>
                <group invisible="method != 'time'" string="Free period">
                    <group>
                        <field name="period_unit"/>
                        <field name="free_days"/>
                        <field name="free_hours"/>
                        <field name="free_mode"/>
                    </group>
                    <group>
                        <field name="tier_mode"/>
                        <field name="friday_monday_free"/>
                        <field name="saturday_until_monday"/>
                        <field name="friday_extra_day"/>
                    </group>
                </group>
                <group invisible="method != 'brackets'">
                    <field name="floor_previous"/>
                    <field name="per_container"/>
                </group>
                <div class="text-muted small mb-1" invisible="method != 'brackets'">
                    The bracket that contains the whole quantity prices all of it (450 kg in «up to 500» = 450 × its
                    price). Cumulative brackets (each part at its own price) are not supported.
                </div>
                <div class="text-muted small mb-1" invisible="method != 'time'">
                    Day tiers: «Up to» is a day number, read as chosen in «Tier mode» (day since the start, day after
                    the free period, or the whole stay).
                </div>
                <div class="small mb-1" invisible="method not in ('brackets', 'time')">
                    <field name="ws_brackets_label" class="fw-semibold"/>
                </div>
                <field name="bracket_ids" invisible="method not in ('brackets', 'time')">
                    <list editable="bottom">
                        <field name="up_to"/>
                        <field name="fixed_amount" column_invisible="parent.method == 'time'"/>
                        <field name="unit_price"/>
                    </list>
                </field>
                <group string="Amount checks">
                    <group>
                        <field name="min_amount"/>
                        <field name="min_per_day" invisible="method != 'time'"/>
                        <field name="max_amount"/>
                        <div colspan="2" class="text-muted small">
                            <field name="ws_bounds_label" class="d-inline"/>. 0 = no minimum / maximum.
                        </div>
                    </group>
                    <group>
                        <field name="on_request"/>
                        <field name="free_of_charge"/>
                        <field name="ws_is_empty" invisible="1"/>
                        <div colspan="2" class="text-danger small" invisible="not ws_is_empty">
                            No amount yet: it counts as a missing price, never as free.
                        </div>
                    </group>
                </group>
                <field name="note" placeholder="Conditions or remarks of the document"/>
                <group string="Live example (computed by the pricing engine)" invisible="not example_text">
                    <field name="example_text" nolabel="1" colspan="2" class="text-muted" style="white-space: pre-line"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="boss_tariff_view_list" model="ir.ui.view">
        <field name="name">boss.tariff.list</field>
        <field name="model">boss.tariff</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'" decoration-warning="state == 'to_approve'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="version"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="direction" optional="show"/>
                <field name="load_type" optional="show"/>
                <field name="carrier_id" optional="show"/>
                <field name="customer_id" optional="hide"/>
                <field name="priority" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'to_approve'"/>
            </list>
        </field>
    </record>

    <record id="boss_tariff_view_search" model="ir.ui.view">
        <field name="name">boss.tariff.search</field>
        <field name="model">boss.tariff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="line_ids" string="Service" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter string="Waiting for approval" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Supplier" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="boss_tariff_action" model="ir.actions.act_window">
        <field name="name">Supplier tariffs</field>
        <field name="res_model">boss.tariff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enter a supplier tariff</p>
            <p>One tariff = one supplier document, its validity and what it applies to. Its prices are used in quotations once approved.</p>
        </field>
    </record>

    <record id="boss_tariff_line_view_list" model="ir.ui.view">
        <field name="name">boss.tariff.line.list</field>
        <field name="model">boss.tariff.line</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="container_size" optional="show"/>
                <field name="method" optional="show"/>
                <field name="unit_price"/>
                <field name="min_amount" optional="show"/>
                <field name="max_amount" optional="hide"/>
                <field name="currency_id" optional="show"/>
                <field name="on_request" optional="hide"/>
                <field name="partner_id"/>
                <field name="tariff_id"/>
                <field name="document_page" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'to_approve'"/>
            </list>
        </field>
    </record>

    <record id="boss_tariff_line_view_search" model="ir.ui.view">
        <field name="name">boss.tariff.line.search</field>
        <field name="model">boss.tariff.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="tariff_id"/>
                <filter string="Approved" name="approved" domain="[('tariff_id.state', '=', 'approved')]"/>
                <filter string="Not approved" name="not_approved" domain="[('tariff_id.state', '!=', 'approved')]"/>
                <group>
                    <filter string="Service" name="groupby_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Supplier" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="boss_tariff_line_action" model="ir.actions.act_window">
        <field name="name">Supplier prices</field>
        <field name="res_model">boss.tariff.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_product': 1}</field>
    </record>
</odoo>
