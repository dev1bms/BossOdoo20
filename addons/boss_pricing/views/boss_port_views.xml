<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boss_port_view_list" model="ir.ui.view">
        <field name="name">boss.port.list</field>
        <field name="model">boss.port</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="country_id"/>
                <field name="canary_islands"/>
            </list>
        </field>
    </record>
    <record id="boss_port_action" model="ir.actions.act_window">
        <field name="name">Ports and airports</field>
        <field name="res_model">boss.port</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
