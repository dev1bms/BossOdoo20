<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Request for quotation and purchase order (ADR-011): the supplier gets the operational data of the file
         (route, vessel, B/L, containers, cargo) under the dates, and the charge base next to the quantity.
         No customer reference, no quotation, no selling price. -->
    <template id="report_purchaseorder_document_boss" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="block" t-value="o._boss_document_block()"/>
            <t t-set="for_supplier" t-value="True"/>
            <t t-call="boss_documents.shipment_block"/>
        </xpath>
        <xpath expr="//span[@t-field='line.uom_id.name']" position="attributes">
            <attribute name="groups"/>
        </xpath>
    </template>
</odoo>
